#!/usr/bin/env python3
"""Serve this checkout, choosing the first available port from 8000."""

import argparse
import errno
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path


class DevServer(ThreadingHTTPServer):
    # Browsers request many assets together; the default backlog of five drops connections.
    request_queue_size = 128


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--port", type=int, help="Use this exact port; fail if occupied")
args = parser.parse_args()
if args.port is not None and not 1 <= args.port <= 65535:
    parser.error("--port must be between 1 and 65535")

handler = partial(SimpleHTTPRequestHandler, directory=str(Path(__file__).resolve().parent))
port = args.port if args.port is not None else 8000
while True:
    try:
        server = DevServer(("127.0.0.1", port), handler)
        break
    except OSError as error:
        if error.errno != errno.EADDRINUSE or args.port is not None or port == 65535:
            parser.exit(1, f"Cannot start server on port {port}: {error}\n")
        port += 1

print(f"http://127.0.0.1:{server.server_port}/", flush=True)
with server:
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
